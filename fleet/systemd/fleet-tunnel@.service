[Unit]
Description=Fleet: let %i reach the hub on its own 127.0.0.1:6780 (reverse SSH tunnel)
After=network-online.target fleet-registry.service

# For a machine the hub can reach but that cannot reach the hub. %i is an SSH
# host alias in ~/.ssh/config with key login; on that machine, join with
# http://127.0.0.1:6780.
[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R 127.0.0.1:6780:127.0.0.1:6780 %i
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
