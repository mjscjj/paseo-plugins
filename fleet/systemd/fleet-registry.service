[Unit]
Description=Fleet registry (hub): nodes, dispatch and the task ledger on :6780
After=network-online.target

[Service]
ExecStart=/usr/bin/env python3 %h/.local/lib/fleet/registry.py
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
